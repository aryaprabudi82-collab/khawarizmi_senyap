APP_NAME="SIMRS Mandiri RSP UI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simrs_mandiri
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# Integrasi nasional - diisi saat lapisan pemetaan digarap (langkah 05)
SATUSEHAT_BASE_URL=
SATUSEHAT_AUTH_URL=
SATUSEHAT_CLIENT_ID=
SATUSEHAT_CLIENT_SECRET=
SATUSEHAT_ORG_ID=
BPJS_VCLAIM_BASE_URL=
BPJS_CONS_ID=
BPJS_SECRET_KEY=
BPJS_USER_KEY=
BPJS_PPK_CODE=

# Autentikasi Active Directory. Kosongkan LDAP_ENABLED atau isi false untuk
# memakai kata sandi lokal saja.
#
# LDAP_ALLOWED_GROUP menentukan SIAPA YANG BOLEH MASUK: hanya anggota grup itu
# yang diterima, sekalipun kata sandi domainnya benar. Dikosongkan berarti
# seluruh akun domain bisa masuk — dan itu jarang yang dimaksud.
#
# LDAP_DEFAULT_ROLE adalah peran yang diberikan otomatis saat anggota grup
# masuk pertama kali. Perlu dipilih sadar: ia menentukan kewenangan orang yang
# belum pernah didaftarkan siapa pun di sistem ini.
LDAP_ENABLED=false
LDAP_LOGGING=true
LDAP_CONNECTION=default
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false
LDAP_ALLOWED_GROUP=
LDAP_DEFAULT_ROLE=
