*.log
.DS_Store
.env

# Ekspor data pasien dari sistem lama — 14 GB CSV berisi PHI NYATA: nama
# pasien, tanggal lahir, alamat, dan catatan anamnesis klinis sungguhan.
#
# TIDAK BOLEH masuk git. Sekali ter-commit, data pasien ada di riwayat
# repositori selamanya dan ikut tersalin ke setiap klon — termasuk ke laptop
# siapa pun yang pernah menariknya. Menghapusnya belakangan menuntut menulis
# ulang seluruh riwayat, dan salinan yang sudah terlanjur tersebar tetap ada.
/database/HSN

# Ekspor data kepegawaian RSUI — nama, NIP, jabatan, unit kerja, dan
# demografi pegawai yang sungguhan. Alasannya sama dengan /database/HSN
# di atas: sekali ter-commit, data pribadi pegawai ada di riwayat
# repositori selamanya dan ikut tersalin ke setiap klon.
/database/data sdm.xlsx
/database/*.xlsx

# Hasil ekspor data untuk dipindahkan ke server lain. Isinya persis sama
# sensitifnya dengan dua baris di atas: nama, NIK, tanggal lahir, alamat,
# dan telepon ratusan ribu pasien, dalam bentuk INSERT yang siap dijalankan.
/ekspor-migrasi
/scripts/ekspor-migrasi
*.dump

