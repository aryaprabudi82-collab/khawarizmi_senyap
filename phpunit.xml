<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
        | Suite ini sudah lebih dari 650 pengujian dan melewati batas memori
        | bawaan PHP (128M) saat dijalankan sekaligus — gejalanya bukan tes
        | gagal, melainkan proses berhenti di tengah jalan dengan "allowed
        | memory size exhausted", yang mudah disalahartikan sebagai regresi.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="simrs_mandiri_test"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!--
        | LDAP dimatikan saat pengujian, dan itu disengaja. Uji yang menghubungi
        | Active Directory sungguhan akan gagal setiap kali server itu dipelihara
        | atau jaringan RS terputus — kegagalan yang tidak ada hubungannya dengan
        | kode yang diubah, dan yang paling cepat mengajari orang mengabaikan
        | suite merah. Jalur LDAP diuji lewat pemalsuan LdapAuthenticator.
        -->
        <env name="LDAP_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
